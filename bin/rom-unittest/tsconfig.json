{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "vitest": ["node_modules/vitest"],
      "vitest/*": ["node_modules/vitest/*"]
    },
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts", "../../src/tests/vitest/**/*.ts", "vitest.config.ts"]
}
