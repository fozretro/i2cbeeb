{
  "name": "i2cbeeb-rom-unittest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BBC sideways ROM unit tests using the jsbeeb 6502 core with mocked MOS APIs",
  "scripts": {
    "test": "vitest run --project standalone",
    "test:composite": "vitest run --project composite",
    "test:classic-composite": "vitest run --project classic-composite",
    "test:classic-only": "vitest run --project classic-only",
    "test:all-fixtures": "vitest run --project standalone --project composite --project classic-only",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "jsbeeb": "github:stardot/jsbeeb"
  },
  "overrides": {
    "vite": "^7.3.5",
    "esbuild": "^0.28.1",
    "serialize-javascript": "^7.0.6"
  }
}
